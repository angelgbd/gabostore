# Configurar estos valores en la aplicación que utilice los repositorios.
# Este paquete recibe la configuración por parámetro; no lee .env automáticamente.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA

# Número comercial internacional, solo dígitos. Vacío mantiene deshabilitada la apertura de WhatsApp.
GABOSTORE_WHATSAPP=

# Solo para ejecutar la demo desde una terminal/backend de confianza.
# Settings > API Keys > Secret keys. Nunca subir esta clave a Git ni usarla en un navegador.
# SUPABASE_SECRET_KEY=TU_CLAVE_SECRETA

# Alternativa sin clave secreta: JWT vigente de un usuario con app_metadata.rol ADMIN o EMPLEADO.
# SUPABASE_USER_TOKEN=JWT_DEL_PERSONAL
