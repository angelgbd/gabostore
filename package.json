{
  "name": "gabostore-datos",
  "version": "1.0.0",
  "private": true,
  "description": "Capas de datos, negocio y presentación React del flujo básico de GaboStore.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "supabase",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p web/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo:datos": "node --env-file=.env --import tsx scripts/demo-pedido.ts",
    "demo:imagenes": "node --env-file=.env --import tsx scripts/cargar-imagenes-demo.ts",
    "preparar:personal": "node --env-file=.env --import tsx scripts/preparar-personal.ts",
    "preparar:admin": "node --env-file=.env --import tsx scripts/preparar-admin.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node --env-file=.env --import tsx scripts/servidor.ts",
    "dev": "npm run build:web && npm start",
    "verificar:conexion": "node --env-file=.env scripts/verificar-conexion.mjs",
    "verificar:flujo": "node --env-file=.env --env-file=.env.personal.local --import tsx scripts/verificar-flujo.ts",
    "verificar:catalogo": "node --env-file=.env --env-file=.env.personal.local --import tsx scripts/verificar-catalogo.ts",
    "verificar:whatsapp": "node --env-file=.env --env-file=.env.personal.local --import tsx scripts/verificar-whatsapp.ts",
    "verificar:release1": "node --env-file=.env --env-file=.env.admin.local --env-file=.env.personal.local --import tsx scripts/verificar-release1.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
